<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's own Info.plist keys for xtool (xtool.yml infoPath). Keep in step with project.yml. -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Talkloop</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talkloop listens while you speak German with your AI partner.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Talkloop turns what you say into text so your partner can answer and correct it.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
